_NEON_COLORS=('\033[36m' '\033[35m' '\033[33m' '\033[32m')  # cyan magenta yellow green

_neon_color() {
    local idx=$(( RANDOM % 4 ))
    printf '%s' "${_NEON_COLORS[$idx]}"
}

# ── Shark swim animation ───────────────────────────────────────────────
shark-swim() {
    local term_width
    term_width=$(tput cols 2>/dev/null || echo 80)
    local shark_width=100
    local max_pos=$(( term_width - shark_width ))
    [[ $max_pos -lt 0 ]] && max_pos=0
    local steps=10
    local step_size=$(( max_pos / steps + 1 ))

    local pos=0
    while [[ $pos -le $max_pos ]]; do
        clear
        local padding
        padding=$(printf '%*s' "$pos" '')
        for line in "${_SHARK_ART[@]}"; do
            printf "\033[36m%s%s\033[0m\n" "$padding" "$line"
        done
        sleep 0.05
        (( pos += step_size ))
    done
    clear
}

# ── Name banner animation ──────────────────────────────────────────────
show-name-banner() {
    local -a art_options=("_SAKIB_ART" "_SHARK_TEXT_ART" "_DENZI_ART" "_X404_ART")
    local chosen="${art_options[$(( RANDOM % 4 ))]}"

    # Indirect expansion to get the chosen array
    local -a art
    case $chosen in
        _SAKIB_ART)      art=("${_SAKIB_ART[@]}") ;;
        _SHARK_TEXT_ART) art=("${_SHARK_TEXT_ART[@]}") ;;
        _DENZI_ART)      art=("${_DENZI_ART[@]}") ;;
        _X404_ART)       art=("${_X404_ART[@]}") ;;
    esac

    local term_width
    term_width=$(tput cols 2>/dev/null || echo 80)
    local art_width=34
    local max_pos=$(( term_width - art_width ))
    [[ $max_pos -lt 0 ]] && max_pos=0

    local pos=0
    while [[ $pos -le $max_pos ]]; do
        clear
        local padding
        padding=$(printf '%*s' "$pos" '')
        for line in "${art[@]}"; do
            local color
            color=$(_neon_color)
            printf "%s%s%s\033[0m\n" "$padding" "$color" "$line"
        done
        sleep 0.05
        (( pos += 4 ))
    done
    clear
}

