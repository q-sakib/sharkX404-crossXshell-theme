{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 2,
  "final_space": true,
  "console_title_template": "{{ .Shell }} — {{ .Folder }}",
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "os",
          "style": "diamond",
          "leading_diamond": "",
          "trailing_diamond": "",
          "foreground": "#011627",
          "background": "#00c7c7",
          "template": "  "
        },
        {
          "type": "session",
          "style": "powerline",
          "powerline_symbol": "",
          "foreground": "#c0caf5",
          "background": "#1a1b26",
          "template": "  {{ .UserName }} "
        },
        {
          "type": "path",
          "style": "powerline",
          "powerline_symbol": "",
          "foreground": "#00c7c7",
          "background": "#16213e",
          "template": "  {{ .Path }} ",
          "properties": {
            "style": "full",
            "max_depth": 4,
            "home_icon": ""
          }
        },
        {
          "type": "git",
          "style": "powerline",
          "powerline_symbol": "",
          "foreground": "#f1f5f9",
          "background": "#7c3aed",
          "foreground_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}#011627{{ end }}"
          ],
          "background_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}#f59e0b{{ end }}",
            "{{ if and (gt .Behind 0) (gt .Ahead 0) }}#db2777{{ end }}",
            "{{ if gt .Behind 0 }}#ef4444{{ end }}",
            "{{ if gt .Ahead 0 }}#22d3ee{{ end }}"
          ],
          "template": "  {{ .HEAD }}{{ if .Working.Changed }}  {{ .Working.String }}{{ end }}{{ if and (.Working.Changed) (.Staging.Changed) }} |{{ end }}{{ if .Staging.Changed }}  {{ .Staging.String }}{{ end }}{{ if gt .StashCount 0 }}  {{ .StashCount }}{{ end }} ",
          "properties": {
            "fetch_status": true,
            "fetch_stash_count": true,
            "fetch_upstream_icon": true,
            "branch_icon": " "
          }
        },
        {
          "type": "node",
          "style": "powerline",
          "powerline_symbol": "",
          "foreground": "#011627",
          "background": "#4ade80",
          "template": "  {{ .Full }} ",
          "properties": {
            "display_mode": "files",
            "fetch_package_manager": true,
            "home_enabled": false
          }
        },
        {
          "type": "php",
          "style": "powerline",
          "powerline_symbol": "",
          "foreground": "#011627",
          "background": "#818cf8",
          "template": "  {{ .Full }} ",
          "properties": {
            "display_mode": "files",
            "home_enabled": false
          }
        },
        {
          "type": "exit",
          "style": "powerline",
          "powerline_symbol": "",
          "foreground": "#011627",
          "background": "#00c7c7",
          "foreground_templates": [
            "{{ if gt .Code 0 }}#ffffff{{ end }}"
          ],
          "background_templates": [
            "{{ if gt .Code 0 }}#ef4444{{ end }}"
          ],
          "template": " {{ if gt .Code 0 }} {{ .Code }}{{ else }}{{ end }} ",
          "properties": {
            "always_enabled": true
          }
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "right",
      "segments": [
        {
          "type": "executiontime",
          "style": "plain",
          "foreground": "#f59e0b",
          "template": " {{ .FormattedMs }} ",
          "properties": {
            "threshold": 2000,
            "style": "austin",
            "always_enabled": false
          }
        },
        {
          "type": "time",
          "style": "plain",
          "foreground": "#4a5568",
          "template": "{{ .CurrentDate | date \"15:04:05\" }} "
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground": "#00c7c7",
          "template": "  "
        }
      ]
    }
  ],
  "transient_prompt": {
    "background": "transparent",
    "foreground": "#00c7c7",
    "template": " "
  }
}
